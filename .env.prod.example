# Local deployment identity and pointers only. See docs/production-configuration.md.
AWS_STACK=example-stack
AWS_PROJECT=example-profile
AWS_REGION=us-west-2
PROD_CONFIG_PREFIX=/example/prod/settings/
PROD_SECRETS_PREFIX=example/prod/secrets/

# Generated artifact state; preserve the existing values when migrating.
WEB_LAMBDA_CODE_TIMESTAMP=
API_LAMBDA_CODE_TIMESTAMP=
IMG_LAMBDA_CODE_TIMESTAMP=
# Asset revisions remain local to support deliberate cache-busting changes.
CSS_CACHE_COUNTER=1
JS_CACHE_COUNTER=1
