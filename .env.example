PROJECT_NAME=blog
WEB_LAMBDA_PORT=5000
API_LAMBDA_PORT=5001
DYNAMODB_PORT=5002

# STAGE ...
AWS_STACK=
AWS_PROJECT=
AWS_REGION=
AWS_OWNER=
APP_STAGE=
APP_ENV=
APP_DEBUG=
APP_SECRET=
DOMAIN_NAME=blog.com
HOSTED_ZONE_ID=
NOTIFICATION_EMAIL=user@example.com
NOTIFICATION_PHONE=+15613145123
GOOGLE_ANALYTICS_ID=
INDEXNOW_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
BING_WEBMASTER_API_KEY=
YANDEX_WEBMASTER_OAUTH_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=
WEB_BASE_URL=https://blog.com
STATIC_BASE_URL=https://static.blog.com
WEB_LAMBDA_CODE_TIMESTAMP=
API_LAMBDA_CODE_TIMESTAMP=
IMG_LAMBDA_CODE_TIMESTAMP=
TELEGRAM_BOT_TOKEN=
# Separate shared bot for optional user channel publishing
TELEGRAM_PUBLISHER_BOT_TOKEN=
TELEGRAM_PUBLISHER_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
TELEGRAM_LOG_LEVEL=INFO
PEXELS_API_KEY=

# Optional Threads publishing (API only)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_TOKEN_ENCRYPTION_KEY=
# Optional LinkedIn member publishing (API only). Client ID/secret from your LinkedIn app.
LINKEDIN_APP_ID=
LINKEDIN_APP_SECRET=
LINKEDIN_TOKEN_ENCRYPTION_KEY=
LINKEDIN_API_VERSION=202610
# Optional local private image storage, outside STATIC_FILES_DIR
MEDIA_ORIGINALS_DIR=/app-media-originals

# Optional Sign in with Apple through Cognito; leave empty to disable.
# Secret JSON fields: services_id, team_id, key_id, private_key.
APPLE_CREDENTIALS_SECRET_ARN=

# Background worker for profile propagation, creator clicks, and account erasure.
# CloudFormation wires BACKGROUND_FUNCTION_NAME automatically in production.
BACKGROUND_FUNCTION_NAME=
# Optional existing Facebook app credentials secret for signed data-deletion requests.
FACEBOOK_CREDENTIALS_SECRET_ARN=
